# Local development overrides
# Root data directory used by the backend in local mode.
# IMAGE_SEARCH_DATA_DIR=./data
# Folder containing the source images to index and search.
# IMAGE_SEARCH_IMAGES_DIR=./data/images
# Embedded/local Qdrant data path when you are not using QDRANT_URL.
# IMAGE_SEARCH_QDRANT_PATH=./data/qdrant
# Default collection searched by the web UI in local mode.
# IMAGE_SEARCH_DEFAULT_COLLECTION=histogram

# Docker / remote Qdrant
# URL of the Qdrant service when backend talks to Qdrant over HTTP.
# QDRANT_URL=http://qdrant:6333
# Optional API key if you later use a protected/managed Qdrant deployment.
# QDRANT_API_KEY=
# Default collection searched by the web UI in Docker / remote mode.
# IMAGE_SEARCH_DEFAULT_COLLECTION=clip
# Print search timing in backend logs when set to 1.
# LOG_SEARCH_TIMING=1
